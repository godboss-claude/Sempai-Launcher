{
  "name": "sempai-launcher",
  "version": "1.2.5",
  "description": "Sempai Launcher — современный лаунчер Minecraft Java Edition",
  "main": "./out/main/index.js",
  "author": "Sempai",
  "repository": {
    "type": "git",
    "url": "https://github.com/godboss-claude/Sempai-Launcher.git"
  },
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "build:win": "electron-vite build && electron-builder --win",
    "build:dir": "electron-vite build && electron-builder --dir",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json"
  },
  "build": {
    "extraResources": [
      {
        "from": "release/mods",
        "to": "visual-mods",
        "filter": [
          "*.jar"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "godboss-claude",
        "repo": "Sempai-Launcher",
        "releaseType": "release"
      }
    ],
    "appId": "ru.sempai.launcher",
    "productName": "Sempai Launcher",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Sempai-Launcher-${version}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Sempai Launcher"
    }
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "electron-updater": "^6.8.11",
    "minecraft-launcher-core": "^3.18.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
